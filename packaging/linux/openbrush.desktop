[Desktop Entry]
Type=Application
Name=OpenBrush
GenericName=Paint
Comment=Draw and edit pictures
Exec=openbrush %f
Icon=openbrush
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;image/x-icon;
StartupWMClass=openbrush
